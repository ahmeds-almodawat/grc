{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://almodawat.sa/schemas/patch83u-staging-sql-editor-checkpoint-file-v1.json",
  "title": "Patch 83U staging SQL Editor checkpoint file",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkpoint",
    "expected_project_ref",
    "operator_project_confirmation_required",
    "transaction_read_only",
    "captured_at",
    "runtime",
    "target",
    "admin",
    "audit",
    "eligible_super_admin_count"
  ],
  "properties": {
    "checkpoint": {
      "enum": [
        "before_employee_sessions",
        "immediately_before_reset",
        "immediately_after_reset",
        "before_required_password_change",
        "immediately_after_password_change_finalization",
        "after_fresh_employee_login"
      ]
    },
    "expected_project_ref": {
      "const": "zghsgzrdwbqdrpuxanac"
    },
    "operator_project_confirmation_required": {
      "const": true
    },
    "transaction_read_only": {
      "const": true
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "admin": {
      "$ref": "#/$defs/admin"
    },
    "audit": {
      "$ref": "#/$defs/audit"
    },
    "eligible_super_admin_count": {
      "type": "integer",
      "minimum": 0
    },
    "applied_migrations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "enum": [
          "174",
          "176",
          "177"
        ]
      }
    },
    "finalizer": {
      "$ref": "#/$defs/finalizer"
    },
    "recovery": {
      "$ref": "#/$defs/recovery"
    }
  },
  "$defs": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "enforcement_state",
        "state_version",
        "edge_contract",
        "frontend_contract",
        "designated_super_admin_id",
        "request_hash_function_available"
      ],
      "properties": {
        "schema_version": {
          "const": "174.2-auth-first"
        },
        "enforcement_state": {
          "const": "enforced"
        },
        "state_version": {
          "type": "integer",
          "minimum": 5
        },
        "edge_contract": {
          "const": "patch83u-edge-auth-first-v1"
        },
        "frontend_contract": {
          "const": "patch83u-frontend-auth-first-v1"
        },
        "designated_super_admin_id": {
          "const": "83d92a59-6909-44e7-80f3-aff60a6734fb"
        },
        "request_hash_function_available": {
          "type": "boolean"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "profile_state",
        "profile_active",
        "same_organization_as_designated_admin",
        "credential_state",
        "credential_version",
        "auth_credential_version",
        "requested_lifecycle",
        "role",
        "scope",
        "active_role_count",
        "pending_operation",
        "pending_operation_count",
        "session_count",
        "unrevoked_refresh_token_count",
        "updated_at"
      ],
      "properties": {
        "user_id": {
          "const": "2a276bdb-cf51-4303-846e-6b7fecf38b0c"
        },
        "profile_state": {
          "const": "active"
        },
        "profile_active": {
          "type": "boolean"
        },
        "same_organization_as_designated_admin": {
          "type": "boolean"
        },
        "credential_state": {
          "enum": [
            "active",
            "reset_in_progress",
            "admin_reset_change_required",
            "password_change_in_progress",
            "session_revocation_review_required",
            "recovery_required"
          ]
        },
        "credential_version": {
          "type": "integer",
          "minimum": 0
        },
        "auth_credential_version": {
          "type": "integer",
          "minimum": 0
        },
        "requested_lifecycle": {
          "const": "active"
        },
        "role": {
          "const": "employee"
        },
        "scope": {
          "const": "assigned_only"
        },
        "active_role_count": {
          "type": "integer",
          "minimum": 0
        },
        "pending_operation": {
          "type": "boolean"
        },
        "pending_operation_count": {
          "type": "integer",
          "minimum": 0
        },
        "session_count": {
          "type": "integer",
          "minimum": 0
        },
        "unrevoked_refresh_token_count": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "profile_state",
        "profile_active",
        "credential_state",
        "credential_version",
        "auth_credential_version",
        "role",
        "scope",
        "active_role_count",
        "pending_operation",
        "pending_operation_count",
        "updated_at"
      ],
      "properties": {
        "user_id": {
          "const": "83d92a59-6909-44e7-80f3-aff60a6734fb"
        },
        "profile_state": {
          "const": "active"
        },
        "profile_active": {
          "type": "boolean"
        },
        "credential_state": {
          "enum": [
            "active",
            "reset_in_progress",
            "admin_reset_change_required",
            "password_change_in_progress",
            "session_revocation_review_required",
            "recovery_required"
          ]
        },
        "credential_version": {
          "type": "integer",
          "minimum": 0
        },
        "auth_credential_version": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "const": "super_admin"
        },
        "scope": {
          "const": "global"
        },
        "active_role_count": {
          "type": "integer",
          "minimum": 0
        },
        "pending_operation": {
          "type": "boolean"
        },
        "pending_operation_count": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "credential_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "latest_event_type": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "latest_event_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z0-9_]{1,100}$"
        },
        "latest_event_credential_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "latest_event_request_id_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "latest_event_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "operation_count": {
          "type": "integer",
          "minimum": 0
        },
        "latest_operation_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "password_change",
            "admin_reset",
            null
          ]
        },
        "latest_operation_status": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "latest_operation_current_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "latest_operation_next_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "latest_operation_resulting_state": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "latest_operation_auth_changed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "latest_operation_revocation_confirmed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "latest_operation_request_id_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "latest_operation_completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "finalizer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "name_bytes",
        "exists",
        "routine_kind_function",
        "destination_name_unique",
        "old_or_truncated_name_absent",
        "security_definer",
        "restricted_search_path",
        "service_role_execute_only"
      ],
      "properties": {
        "name": {
          "const": "patch83u_finalize_password_change_after_revocation"
        },
        "name_bytes": {
          "const": 50
        },
        "exists": {
          "type": "boolean"
        },
        "routine_kind_function": {
          "type": "boolean"
        },
        "destination_name_unique": {
          "type": "boolean"
        },
        "old_or_truncated_name_absent": {
          "type": "boolean"
        },
        "security_definer": {
          "type": "boolean"
        },
        "restricted_search_path": {
          "type": "boolean"
        },
        "service_role_execute_only": {
          "type": "boolean"
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wrapper_exists",
        "implementation_exists",
        "standard_implementation_exists",
        "wrapper_security_definer",
        "wrapper_restricted_search_path",
        "wrapper_service_role_execute_only",
        "implementation_not_callable_by_service_role",
        "standard_implementation_owner_only"
      ],
      "properties": {
        "wrapper_exists": {
          "type": "boolean"
        },
        "implementation_exists": {
          "type": "boolean"
        },
        "standard_implementation_exists": {
          "type": "boolean"
        },
        "wrapper_security_definer": {
          "type": "boolean"
        },
        "wrapper_restricted_search_path": {
          "type": "boolean"
        },
        "wrapper_service_role_execute_only": {
          "type": "boolean"
        },
        "implementation_not_callable_by_service_role": {
          "type": "boolean"
        },
        "standard_implementation_owner_only": {
          "type": "boolean"
        }
      }
    }
  }
}
