{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://almodawat.sa/schemas/patch83u-staging-reset-proof-v1.json",
  "title": "Patch 83U redacted staging multi-session reset proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "execution_status",
    "project_ref",
    "subject_user_id",
    "request_id_hash",
    "events",
    "operator_guidance"
  ],
  "properties": {
    "schema_version": {
      "const": "patch83u-staging-reset-proof-v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "execution_status": {
      "enum": [
        "readiness_failed",
        "reset_blocked",
        "reset_finalization_unclear",
        "password_change_blocked",
        "operator_stopped",
        "completed"
      ]
    },
    "project_ref": {
      "const": "zghsgzrdwbqdrpuxanac"
    },
    "subject_user_id": {
      "const": "2a276bdb-cf51-4303-846e-6b7fecf38b0c"
    },
    "request_id_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "preflight": {
      "$ref": "#/$defs/preflight"
    },
    "reset": {
      "$ref": "#/$defs/reset"
    },
    "revocation": {
      "$ref": "#/$defs/revocation"
    },
    "forced_password_change_gate": {
      "$ref": "#/$defs/forcedPasswordChangeGate"
    },
    "password_change": {
      "$ref": "#/$defs/passwordChange"
    },
    "fresh_login": {
      "$ref": "#/$defs/freshLogin"
    },
    "audit": {
      "$ref": "#/$defs/auditEvidence"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "operator_guidance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operatorGuidance"
      }
    }
  },
  "$defs": {
    "safeError": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
    },
    "httpStatus": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 100,
      "maximum": 599
    },
    "roleScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "scope"
      ],
      "properties": {
        "role": {
          "enum": [
            "employee",
            "super_admin"
          ]
        },
        "scope": {
          "enum": [
            "assigned_only",
            "global"
          ]
        }
      }
    },
    "credentialProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_state",
        "database_credential_version",
        "auth_credential_version",
        "requested_lifecycle",
        "session_count",
        "unrevoked_refresh_token_count",
        "role",
        "scope",
        "observed_at"
      ],
      "properties": {
        "credential_state": {
          "enum": [
            "active",
            "reset_in_progress",
            "admin_reset_change_required",
            "password_change_in_progress",
            "session_revocation_review_required",
            "recovery_required"
          ]
        },
        "database_credential_version": {
          "type": "integer",
          "minimum": 0
        },
        "auth_credential_version": {
          "type": "integer",
          "minimum": 0
        },
        "requested_lifecycle": {
          "const": "active"
        },
        "session_count": {
          "type": "integer",
          "minimum": 0
        },
        "unrevoked_refresh_token_count": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "const": "employee"
        },
        "scope": {
          "const": "assigned_only"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "checks",
        "failed"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "checks": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        }
      }
    },
    "reset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submitted",
        "submission_count",
        "http_status",
        "safe_error_code"
      ],
      "properties": {
        "submitted": {
          "type": "boolean"
        },
        "submission_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "http_status": {
          "$ref": "#/$defs/httpStatus"
        },
        "safe_error_code": {
          "$ref": "#/$defs/safeError"
        },
        "terminal_proof": {
          "$ref": "#/$defs/credentialProof"
        }
      }
    },
    "refreshReplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "failed",
        "http_status",
        "safe_error_code",
        "observed_at"
      ],
      "properties": {
        "label": {
          "enum": [
            "employee_context_a",
            "employee_context_b"
          ]
        },
        "failed": {
          "const": true
        },
        "http_status": {
          "$ref": "#/$defs/httpStatus"
        },
        "safe_error_code": {
          "$ref": "#/$defs/safeError"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_permanent_login_failed",
        "old_permanent_login_http_status",
        "old_permanent_login_safe_error_code",
        "refresh_replay_results",
        "stale_context_a_denied",
        "stale_context_b_denied",
        "database_session_count",
        "unrevoked_refresh_token_count",
        "observed_at"
      ],
      "properties": {
        "old_permanent_login_failed": {
          "type": "boolean"
        },
        "old_permanent_login_http_status": {
          "$ref": "#/$defs/httpStatus"
        },
        "old_permanent_login_safe_error_code": {
          "$ref": "#/$defs/safeError"
        },
        "refresh_replay_results": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/refreshReplay"
          }
        },
        "stale_context_a_denied": {
          "type": "boolean"
        },
        "stale_context_b_denied": {
          "type": "boolean"
        },
        "database_session_count": {
          "type": "integer",
          "minimum": 0
        },
        "unrevoked_refresh_token_count": {
          "type": "integer",
          "minimum": 0
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "forcedPasswordChangeGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temporary_login_succeeded",
        "forced_change_only",
        "normal_application_access_denied",
        "observed_at"
      ],
      "properties": {
        "temporary_login_succeeded": {
          "type": "boolean"
        },
        "forced_change_only": {
          "type": "boolean"
        },
        "normal_application_access_denied": {
          "type": "boolean"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "passwordChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submitted",
        "submission_count",
        "http_status",
        "safe_error_code",
        "terminal_proof",
        "browser_signed_out"
      ],
      "properties": {
        "submitted": {
          "type": "boolean"
        },
        "submission_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "http_status": {
          "$ref": "#/$defs/httpStatus"
        },
        "safe_error_code": {
          "$ref": "#/$defs/safeError"
        },
        "terminal_proof": {
          "$ref": "#/$defs/credentialProof"
        },
        "browser_signed_out": {
          "type": "boolean"
        }
      }
    },
    "freshLogin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permanent_login_succeeded",
        "role",
        "scope",
        "admin_route_denied",
        "authorized_route",
        "database_credential_version",
        "auth_credential_version",
        "database_session_count",
        "unrevoked_refresh_token_count",
        "observed_at"
      ],
      "properties": {
        "permanent_login_succeeded": {
          "type": "boolean"
        },
        "role": {
          "const": "employee"
        },
        "scope": {
          "const": "assigned_only"
        },
        "admin_route_denied": {
          "type": "boolean"
        },
        "authorized_route": {
          "type": "string",
          "maxLength": 100
        },
        "database_credential_version": {
          "const": 4
        },
        "auth_credential_version": {
          "const": 4
        },
        "database_session_count": {
          "type": "integer",
          "minimum": 1
        },
        "unrevoked_refresh_token_count": {
          "type": "integer",
          "minimum": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "auditSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_event_count",
        "latest_event_type",
        "latest_event_code",
        "latest_event_credential_version",
        "latest_event_request_id_hash",
        "latest_event_at",
        "operation_count",
        "latest_operation_type",
        "latest_operation_status",
        "latest_operation_current_version",
        "latest_operation_next_version",
        "latest_operation_resulting_state",
        "latest_operation_auth_changed",
        "latest_operation_revocation_confirmed",
        "latest_operation_request_id_hash",
        "latest_operation_completed_at"
      ],
      "properties": {
        "credential_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "latest_event_type": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "latest_event_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z0-9_]{1,100}$"
        },
        "latest_event_credential_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "latest_event_request_id_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "latest_event_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "operation_count": {
          "type": "integer",
          "minimum": 0
        },
        "latest_operation_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "password_change",
            "admin_reset",
            null
          ]
        },
        "latest_operation_status": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "latest_operation_current_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "latest_operation_next_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "latest_operation_resulting_state": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "latest_operation_auth_changed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "latest_operation_revocation_confirmed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "latest_operation_request_id_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "latest_operation_completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "auditEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after_reset"
      ],
      "properties": {
        "after_reset": {
          "$ref": "#/$defs/auditSnapshot"
        },
        "after_password_change": {
          "$ref": "#/$defs/auditSnapshot"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "result",
        "observed_at"
      ],
      "properties": {
        "event": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "result": {
          "type": "boolean"
        },
        "http_status": {
          "$ref": "#/$defs/httpStatus"
        },
        "safe_error_code": {
          "$ref": "#/$defs/safeError"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "operatorGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "guidance",
        "observed_state"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "guidance": {
          "type": "string",
          "maxLength": 600
        },
        "observed_state": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        }
      }
    }
  }
}
